# Parcial-pr-ctico-1
Parcial 1
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Parcial práctico 1 - G611 - 2026: página con HTML semántico, formulario, tabla y CSS externo.">
  <title>Parcial práctico 1 - G611 - 2026 - Marco Obregón</title>
  <link rel="stylesheet" href="estilos.css">
</head>
<body>
  <a class="salto" href="#contenido">Skip to main content</a>

  <header class="cabecera">
    <a class="logo" href="#">Marco Obregón</a>
    <nav aria-label="Main navigation">
      <ul>
        <li><a href="#">Home</a></li>
        <li><a href="#articulos">About</a></li>
        <li><a href="#formulario">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main id="contenido">
    <section id="articulos" class="articulos" aria-labelledby="titulo-articulos">
      <h1 id="titulo-articulos" class="visualmente-oculto">Articles</h1>
      <article>
        <img src="imagen-80x80.svg" alt="Placeholder image for the first article" width="80" height="80">
        <h2>Article Title</h2>
        <p>Article content goes here. This is a sample article content.</p>
      </article>
      <article>
        <img src="imagen-80x80.svg" alt="Placeholder image for the second article" width="80" height="80">
        <h2>Article Title</h2>
        <p>Article content goes here. This is a sample article content.</p>
      </article>
    </section>

    <section id="formulario" class="bloque" aria-labelledby="titulo-formulario">
      <h2 id="titulo-formulario">Contact Form</h2>
      <form action="#" method="post">
        <label for="nombre">Name:</label>
        <input type="text" id="nombre" name="nombre" autocomplete="name" required>

        <label for="correo">Email:</label>
        <input type="email" id="correo" name="correo" autocomplete="email" required>

        <label for="mensaje">Message:</label>
        <textarea id="mensaje" name="mensaje" rows="3" required></textarea>

        <button type="submit">Submit</button>
      </form>
    </section>

    <section class="bloque" aria-labelledby="titulo-notas">
      <h2 id="titulo-notas">Student Scores</h2>
      <table>
        <caption class="visualmente-oculto">Student scores in HTML and CSS, with totals</caption>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">HTML</th>
            <th scope="col">CSS</th>
            <th scope="col">Total</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">John</th>
            <td>80</td>
            <td>90</td>
            <td>170</td>
          </tr>
          <tr>
            <th scope="row">Jane</th>
            <td>85</td>
            <td>95</td>
            <td>180</td>
          </tr>
        </tbody>
        <tfoot>
          <tr>
            <th scope="row" colspan="3">Total</th>
            <td>350</td>
          </tr>
        </tfoot>
      </table>
    </section>
  </main>

  <footer class="pie">
    <p>Contact us at: <a href="mailto:info@example.com">info@example.com</a></p>
  </footer>
</body>
</html>
